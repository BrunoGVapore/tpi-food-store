# Conexión a PostgreSQL (crear antes la base vacía foodstore_db).
# Para desarrollo rápido también se acepta SQLite: DATABASE_URL=sqlite:///./foodstore.db
DATABASE_URL=postgresql://postgres:cambiar_password@localhost:5432/foodstore_db

# Clave para firmar el JWT: mínimo 32 caracteres.
# Generar una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido por CORS (con credenciales).
FRONTEND_ORIGIN=http://localhost:5173
